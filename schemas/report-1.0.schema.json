{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:hris-reconcile:report:1.0",
  "title": "HRIS Reconciliation JSON report",
  "description": "Report format 1.0 (superseded by report-2.0.schema.json; kept for reference). Produced by the browser workbench until Phase 4.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "run_metadata",
    "contract_name",
    "datasets",
    "identity_summary",
    "field_comparison_summary",
    "details"
  ],
  "properties": {
    "run_metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format_version",
        "engine_version",
        "processing_mode"
      ],
      "properties": {
        "format_version": {
          "const": "1.0"
        },
        "engine_version": {
          "type": "string"
        },
        "processing_mode": {
          "const": "browser"
        }
      }
    },
    "contract_name": {
      "type": "string"
    },
    "datasets": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "left",
        "right"
      ],
      "properties": {
        "left": {
          "$ref": "#/$defs/dataset"
        },
        "right": {
          "$ref": "#/$defs/dataset"
        }
      }
    },
    "identity_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "MATCHED",
        "MISSING_LEFT",
        "MISSING_RIGHT",
        "DUPLICATE_LEFT",
        "DUPLICATE_RIGHT"
      ],
      "properties": {
        "MATCHED": {
          "$ref": "#/$defs/count"
        },
        "MISSING_LEFT": {
          "$ref": "#/$defs/count"
        },
        "MISSING_RIGHT": {
          "$ref": "#/$defs/count"
        },
        "DUPLICATE_LEFT": {
          "$ref": "#/$defs/count"
        },
        "DUPLICATE_RIGHT": {
          "$ref": "#/$defs/count"
        },
        "MISSING_IDENTITY_LEFT": {
          "$ref": "#/$defs/count"
        },
        "MISSING_IDENTITY_RIGHT": {
          "$ref": "#/$defs/count"
        }
      }
    },
    "field_comparison_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "MATCH_EXACT",
        "MATCH_NORMALIZED",
        "MATCH_MAPPED",
        "BOTH_NULL",
        "LEFT_NULL",
        "RIGHT_NULL",
        "UNMAPPED_LEFT",
        "UNMAPPED_RIGHT",
        "MISMATCH"
      ],
      "properties": {
        "MATCH_EXACT": {
          "$ref": "#/$defs/count"
        },
        "MATCH_NORMALIZED": {
          "$ref": "#/$defs/count"
        },
        "MATCH_MAPPED": {
          "$ref": "#/$defs/count"
        },
        "BOTH_NULL": {
          "$ref": "#/$defs/count"
        },
        "LEFT_NULL": {
          "$ref": "#/$defs/count"
        },
        "RIGHT_NULL": {
          "$ref": "#/$defs/count"
        },
        "UNMAPPED_LEFT": {
          "$ref": "#/$defs/count"
        },
        "UNMAPPED_RIGHT": {
          "$ref": "#/$defs/count"
        },
        "MISMATCH": {
          "$ref": "#/$defs/count"
        }
      }
    },
    "details": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identities",
        "field_comparisons"
      ],
      "properties": {
        "identities": {
          "type": "array",
          "items": {
            "anyOf": [
              {
                "$ref": "#/$defs/keyed_identity"
              },
              {
                "$ref": "#/$defs/missing_identity"
              }
            ]
          }
        },
        "field_comparisons": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "identity",
              "field_name",
              "left_raw_value",
              "right_raw_value",
              "left_normalized_value",
              "right_normalized_value",
              "left_canonical_value",
              "right_canonical_value",
              "status",
              "mapping_name"
            ],
            "properties": {
              "identity": {
                "type": "string"
              },
              "field_name": {
                "type": "string"
              },
              "left_raw_value": {
                "$ref": "#/$defs/nullable_string"
              },
              "right_raw_value": {
                "$ref": "#/$defs/nullable_string"
              },
              "left_normalized_value": {
                "$ref": "#/$defs/nullable_string"
              },
              "right_normalized_value": {
                "$ref": "#/$defs/nullable_string"
              },
              "left_canonical_value": {
                "$ref": "#/$defs/nullable_string"
              },
              "right_canonical_value": {
                "$ref": "#/$defs/nullable_string"
              },
              "status": {
                "$ref": "#/$defs/field_status"
              },
              "mapping_name": {
                "$ref": "#/$defs/nullable_string"
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "count": {
      "type": "integer",
      "minimum": 0
    },
    "nullable_string": {
      "type": [
        "string",
        "null"
      ]
    },
    "dataset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "record_count",
        "column_count"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "record_count": {
          "$ref": "#/$defs/count"
        },
        "column_count": {
          "$ref": "#/$defs/count"
        }
      }
    },
    "keyed_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identity",
        "status"
      ],
      "properties": {
        "identity": {
          "type": "string"
        },
        "status": {
          "enum": [
            "MATCHED",
            "MISSING_LEFT",
            "MISSING_RIGHT",
            "DUPLICATE_LEFT",
            "DUPLICATE_RIGHT"
          ]
        }
      }
    },
    "missing_identity": {
      "description": "A record whose identity is null or all whitespace; identity holds the raw value.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identity",
        "status"
      ],
      "properties": {
        "identity": {
          "$ref": "#/$defs/nullable_string"
        },
        "status": {
          "enum": [
            "MISSING_IDENTITY_LEFT",
            "MISSING_IDENTITY_RIGHT"
          ]
        }
      }
    },
    "field_status": {
      "enum": [
        "MATCH_EXACT",
        "MATCH_NORMALIZED",
        "MATCH_MAPPED",
        "BOTH_NULL",
        "LEFT_NULL",
        "RIGHT_NULL",
        "UNMAPPED_LEFT",
        "UNMAPPED_RIGHT",
        "MISMATCH"
      ]
    }
  }
}
