{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:hris-reconcile:contract:1.0",
  "title": "HRIS Reconciliation contract document",
  "description": "Saved/imported contract (src/web/core/contract_document.ts); also embedded as 'contract' in report format 2.0.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "name",
    "left",
    "right",
    "identity",
    "fields",
    "value_mappings"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "name": {
      "type": "string"
    },
    "left": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string"
        }
      }
    },
    "right": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string"
        }
      }
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "left",
        "right",
        "normalize"
      ],
      "properties": {
        "left": {
          "type": "string"
        },
        "right": {
          "type": "string"
        },
        "normalize": {
          "type": "array",
          "items": {
            "enum": [
              "trim",
              "strip_leading_zeros",
              "casefold"
            ]
          }
        }
      }
    },
    "fields": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "left",
          "right",
          "mode",
          "normalize",
          "value_mapping"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "left": {
            "type": "string"
          },
          "right": {
            "type": "string"
          },
          "mode": {
            "enum": [
              "Exact",
              "Normalized text",
              "Value mapping",
              "Custom"
            ]
          },
          "normalize": {
            "type": "array",
            "items": {
              "enum": [
                "nfc",
                "trim",
                "uppercase",
                "lowercase",
                "casefold",
                "collapse_whitespace",
                "strip_leading_zeros"
              ]
            }
          },
          "value_mapping": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "value_mappings": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "left",
            "right"
          ],
          "properties": {
            "left": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "right": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  }
}
