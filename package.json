{
  "name": "hris-reconcile-web",
  "version": "1.0.0",
  "description": "Pure in-browser client-side HRIS reconciliation engine",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && cp dist/index.html dist/hris-reconcile.html",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:browser": "npm run build && playwright test",
    "test:watch": "vitest",
    "verify": "node scripts/verify.mjs"
  },
  "dependencies": {
    "papaparse": "^5.5.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.9",
    "@types/papaparse": "^5.3.15",
    "@playwright/test": "^1.63.0",
    "typescript": "^5.8.2",
    "vite": "^6.2.0",
    "vite-plugin-singlefile": "^2.1.0",
    "vitest": "^3.0.7"
  }
}
